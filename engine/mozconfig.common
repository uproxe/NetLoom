# NetLoom — общие настройки движка (Gecko ESR) для всех платформ.
# engine/build.sh собирает итоговый mozconfig: этот файл + mozconfig.<платформа>.

ac_add_options --enable-application=browser

# Инструменты (clang, rust, nasm, cbindgen, node…) скачиваются сборкой сами.
# sccache ставит GitHub Actions, поэтому его не скачиваем.
ac_add_options --enable-bootstrap=-sccache

# ── Бренд ──
ac_add_options --with-app-name=netloom
ac_add_options --with-app-basename=NetLoom
ac_add_options --with-branding=browser/branding/netloom
ac_add_options --with-distribution-id=io.github.uproxe

# ── Сборка ──
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-debug-js-modules
ac_add_options --disable-tests
ac_add_options --disable-rust-tests
ac_add_options --disable-geckodriver

# ── Без служб Mozilla ──
ac_add_options --disable-crashreporter
ac_add_options --disable-updater

# Встроенные части NetLoom не подписываются у Mozilla
export MOZ_REQUIRE_SIGNING=
ac_add_options --with-unsigned-addon-scopes=app,system
ac_add_options --allow-addon-sideload

# Русский язык: переводы из mozilla-l10n (путь задаёт engine/build.sh)
ac_add_options --with-l10n-base="$HOME/.mozbuild/l10n-central"

# Кэш компиляции в GitHub Actions
# (именно тот sccache, что поставил GitHub Actions: он умеет новое хранилище кэша GitHub)
if test "$SCCACHE_GHA_ENABLED" = "true"; then
  ac_add_options --with-ccache="${SCCACHE_PATH:-sccache}"
  mk_add_options "export RUSTC_WRAPPER=${SCCACHE_PATH:-sccache}"
  mk_add_options 'export CCACHE_CPP2=yes'
fi

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-netloom
