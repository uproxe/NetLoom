[Desktop Entry]
Version=1.0
Type=Application
Name=NetLoom
GenericName=Веб-браузер
Comment=Приватный браузер со встроенным VPN и блокировкой рекламы
Exec=netloom %u
Icon=netloom
Terminal=false
StartupNotify=true
StartupWMClass=netloom
Categories=Network;WebBrowser;
Keywords=браузер;интернет;веб;vpn;web;browser;internet;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/pdf;image/svg+xml;image/webp;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=Новое окно
Exec=netloom --new-window %u

[Desktop Action new-private-window]
Name=Новое приватное окно
Exec=netloom --private-window %u
